# Copy this file to .env to try live competitions on your computer. Git ignores .env.
# Both values are on Supabase: Project Settings > API (or Data API).
#
# Only these two go here. Never put the service_role key or any password in this file,
# in src/, or anywhere else in the repository.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
