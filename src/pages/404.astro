---
import Base from '../layouts/Base.astro';
import { defaultLocale, href, t } from '../i18n/config';

const lang = defaultLocale;
const text = t(lang).notFound;
---
<Base title={text.title} description={text.text} lang={lang} noindex>
  <h1>{text.title}</h1>
  <p>{text.text}</p>
  <div class="btn-row">
    <a class="btn btn-primary" href={href(lang)}>{text.home}</a>
    <a class="btn" href={href(lang, 'pathway/')}>{text.pathway}</a>
  </div>
  <p><a href={href(lang, 'sitemap/')}>{text.sitemap}</a></p>
</Base>
