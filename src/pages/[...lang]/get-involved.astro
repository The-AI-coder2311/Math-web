---
import Base from '../../layouts/Base.astro';
import { getPage } from '../../lib/content';
import { localePaths, t } from '../../i18n/config';
import { site } from '../../site.config';

export const getStaticPaths = () => localePaths();

const { lang } = Astro.props;
const text = t(lang).getInvolved;
const page = await getPage(lang, 'get-involved');
const mail = (subject: string) => `mailto:${site.contactEmail}?subject=${encodeURIComponent(subject)}`;
---
<Base title={page.title} description={page.description} lang={lang} current="about">
  <h1>{page.title}</h1>
  <div class="prose" set:html={page.html} />
  <section class="card">
    <h2>{text.contactTitle}</h2>
    <p>{text.contactText(site.contactEmail)}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={mail(text.volunteerSubject)}>{text.volunteer}</a>
      <a class="btn" href={mail(text.problemSubject)}>{text.problem}</a>
      <a class="btn" href={mail(text.schoolSubject)}>{text.school}</a>
    </div>
  </section>
</Base>
