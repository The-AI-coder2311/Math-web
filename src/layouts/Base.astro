---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { analytics, analyticsOn, site } from '../site.config';
import { defaultLocale, href, hrefIn, locales, t, type Locale } from '../i18n/config';
import { pageExists } from '../lib/content';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  current?: 'learn' | 'contests' | 'competitions' | 'formulas' | 'teachers' | 'about';
  /** For a page that shouldn't be in search results or the sitemap, such as the 404 page. */
  noindex?: boolean;
}

const { title, description, lang, current, noindex } = Astro.props;
const text = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The current page's address without the hosting base path or language, like "pathway/".
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = Astro.url.pathname
  .slice(basePath.length)
  .replace(/^\//, '')
  .replace(new RegExp(`^${lang === defaultLocale ? '' : `${lang}/`}`), '');
// The same page in each other language, or that language's home page if it isn't translated yet.
const alternates = locales
  .filter((other) => other !== lang)
  .map((other) => ({ lang: other, exists: pageExists(other, pagePath), url: hrefIn(other, pageExists(other, pagePath) ? pagePath : '') }));
const navItems = [
  { key: 'learn', label: text.nav.learn, url: href(lang, 'pathway/') },
  { key: 'contests', label: text.nav.contests, url: href(lang, 'contests/') },
  { key: 'competitions', label: text.nav.competitions, url: href(lang, 'competitions/') },
  { key: 'formulas', label: text.nav.formulas, url: href(lang, 'formulas/') },
  { key: 'teachers', label: text.nav.teachers, url: href(lang, 'teachers/') },
  { key: 'about', label: text.nav.about, url: href(lang, 'about/') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} | ${site.name}`}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.filter((other) => other.exists).map((other) => (
      <link rel="alternate" hreflang={other.lang} href={new URL(other.url, Astro.site).href} />
    ))}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('count-me-in-theme');
        if (savedTheme) document.documentElement.dataset.theme = savedTheme;
      } catch (e) {}
    </script>
    {analyticsOn && analytics.provider === 'plausible' && (
      <script is:inline defer data-domain={analytics.siteId} src="https://plausible.io/js/script.js"></script>
    )}
    {analyticsOn && analytics.provider === 'goatcounter' && (
      <script is:inline async data-goatcounter={`https://${analytics.siteId}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
    <noscript><style>.needs-js { display: none !important; } .no-js-show { display: block !important; } .site-header nav { display: block !important; }</style></noscript>
  </head>
  <body data-scroll-label={text.scrollLabel}>
    <a class="skip-link no-print" href="#main">{text.skipLink}</a>
    <header class="site-header no-print">
      <div class="wrap site-header-inner">
        <a class="logo-link" href={href(lang)}><Logo /></a>
        <button class="menu-toggle needs-js" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          {text.nav.menu}
        </button>
        <nav id="site-nav" aria-label={text.nav.label}>
          <ul>
            {navItems.map((item) => (
              <li><a href={item.url} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <ul class="language-switch">
          {alternates.map((other) => (
            <li>
              <a href={other.url} lang={other.lang} hreflang={other.lang} aria-label={t(other.lang).language.switchLabel}>
                <span class="lang-long">{t(other.lang).language.name}</span><span class="lang-short" aria-hidden="true">{other.lang.toUpperCase()}</span>
              </a>
            </li>
          ))}
        </ul>
        <button
          class="theme-toggle needs-js"
          type="button"
          aria-label={text.theme.toDark}
          data-theme-toggle
          data-to-dark={text.theme.toDark}
          data-to-light={text.theme.toLight}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class="wrap" tabindex="-1"><slot /></main>
    <footer class="site-footer no-print">
      <div class="wrap">
        <p>{analyticsOn ? text.footer.freeCounted : text.footer.free}</p>
        <p class="muted">{text.footer.disclaimer}</p>
        <nav aria-label={text.footer.navLabel}>
          <ul class="footer-links">
            <li><a href={href(lang, 'glossary/')}>{text.footer.glossary}</a></li>
            <li><a href={href(lang, 'get-involved/')}>{text.footer.getInvolved}</a></li>
            <li><a href={href(lang, 'accessibility/')}>{text.footer.accessibility}</a></li>
            <li><a href={href(lang, 'sitemap/')}>{text.footer.sitemap}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/site';

      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
      const label = () => {
        if (toggle) toggle.setAttribute('aria-label', isDark() ? toggle.dataset.toLight! : toggle.dataset.toDark!);
      };
      label();
      toggle?.addEventListener('click', () => {
        root.dataset.theme = isDark() ? 'light' : 'dark';
        try {
          localStorage.setItem('count-me-in-theme', root.dataset.theme);
        } catch {
          // Blocked storage: the theme still applies until the page changes.
        }
        label();
      });
    </script>
  </body>
</html>
